# CogniFlow RAG System - Essential Configuration

# PostgreSQL Database
POSTGRES_DB_URL=postgresql+asyncpg://postgres:password@localhost:5432/cogniflow

# JWT Configuration
AUTH_SECRET_KEY=your-secret-key-here

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_SSL=false

# Application Settings
DEBUG=true

# Pockity Storage Service
POCKITY_API_URL=your-pockity-api-url
POCKITY_ACCESS_KEY_ID=your-access-key-id
POCKITY_SECRET_KEY=your-secret-key

# SMTP Email Configuration (Required for OTP functionality)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL_ID=your-email@gmail.com
SMTP_PASSWORD=your-app-password